service cloud.firestore {
  function isAdmin() {
    // Set via Firebase Custom Claims: admin=true
    return request.auth != null && request.auth.token.admin == true;
  }

  function userProfileExists() {
    return request.auth != null
      && exists(/databases/$(database)/documents/users/$(request.auth.uid));
  }

  function currentUserProfile() {
    return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
  }

  function hasCurrentPaidAccess() {
    return userProfileExists()
      && currentUserProfile().isPaid == true
      && currentUserProfile().paidAccessUntil is timestamp
      && currentUserProfile().paidAccessUntil > request.time;
  }

  function canReadPlanContent(contentPlan) {
    return hasCurrentPaidAccess() && (
      contentPlan == currentUserProfile().plan ||
      (currentUserProfile().plan in ['platinum_star', 'platinum'] && contentPlan == 'gold')
    );
  }

  match /databases/{database}/documents {
    // Students can create their own Bronze profile, but cannot grant themselves
    // paid access, change their plan, or assign privileged roles. Paystack webhook
    // updates use the Firebase Admin SDK and bypass these client rules.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.grade in ['10', '11', '12']
        && request.resource.data.plan == 'trial'
        && request.resource.data.isPaid == false
        && request.resource.data.trialUsed == false
        && request.resource.data.privacyConsentAccepted == true
        && request.resource.data.keys().hasAll([
          'name', 'email', 'grade', 'plan', 'isPaid', 'trialUsed',
          'privacyConsentAccepted', 'privacyConsentAcceptedAt', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'grade', 'plan', 'isPaid', 'trialUsed',
          'privacyConsentAccepted', 'privacyConsentAcceptedAt', 'createdAt'
        ]);
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
      allow delete: if false;
    }

    
    // Admin uploads
    match /uploads/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Content: read if free or matches user plan, admin write
    match /lessons/{docId} {
      allow read: if request.auth != null && (
        resource.data.isFree == true ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        canReadPlanContent(resource.data.plan)
      ); // FIXED: Added exists() check prevents errors
      allow write: if isAdmin();
    }
    
    match /past_papers/{docId} {
      allow read: if request.auth != null && (
        resource.data.isFree == true ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        canReadPlanContent(resource.data.plan)
      ); // FIXED: Added exists() check prevents errors
      allow write: if isAdmin();
    }
    
    match /announcements/{docId} {
      allow read: if request.auth != null && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (resource.data.grade == 'all' ||
           resource.data.grade == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.grade))
      );
      allow write: if isAdmin();
    }
  }
}

