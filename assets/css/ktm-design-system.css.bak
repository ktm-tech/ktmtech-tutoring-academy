/* KTM Academy Design System — single source of truth */
:root {
  color-scheme: light;
  --ktm-bg: #ffffff;
  --ktm-surface: #ffffff;
  --ktm-subtle: #f8fafc;
  --ktm-text: #17243a;
  --ktm-muted: #64748b;
  --ktm-border: #e2e8f0;
  --ktm-primary: #2563eb;
  --ktm-primary-hover: #1d4ed8;
  --ktm-primary-soft: #eff6ff;
  --ktm-success: #15803d;
  --ktm-danger: #b91c1c;
  --ktm-radius: 14px;
  --ktm-shadow: 0 10px 30px rgba(15, 23, 42, .06);
  --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
}
*, *::before, *::after { box-sizing: border-box; }
html { min-width: 320px; background: var(--ktm-bg); scroll-behavior: smooth; }
body { min-width: 320px; margin: 0; color: var(--ktm-text); background: var(--ktm-bg); font-family: var(--font-stack); line-height: 1.6; overflow-x: hidden; }
img, svg, video { max-width: 100%; }
button, input, select, textarea { font: inherit; }
button { cursor: pointer; }
button:disabled { cursor: not-allowed; opacity: .58; }
.hidden, [hidden] { display: none !important; }
.visually-hidden { position:absolute!important; width:1px!important; height:1px!important; padding:0!important; margin:-1px!important; overflow:hidden!important; clip:rect(0,0,0,0)!important; white-space:nowrap!important; border:0!important; }
:focus-visible { outline: 3px solid rgba(37,99,235,.28); outline-offset: 2px; }
::selection { color: #17243a; background: #dbeafe; }
.card-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,245px),1fr)); gap:1rem; }
.form-group { min-width:0; margin-bottom:1rem; }
.form-group label { display:block; margin-bottom:.4rem; color:#334155; font-size:.9rem; font-weight:650; }
.form-group input:not([type=checkbox]):not([type=radio]), .form-group select, .form-group textarea,
input[type=text], input[type=email], input[type=password], input[type=number], input[type=url], input[type=search], select, textarea {
  width:100%; min-height:44px; padding:.7rem .8rem; border:1px solid #cbd5e1; border-radius:.6rem; color:#17243a; background:#fff; font:400 .95rem/1.45 var(--font-stack); transition:border-color .16s ease, box-shadow .16s ease;
}
textarea { min-height:110px; resize:vertical; }
input:focus, select:focus, textarea:focus { border-color:#60a5fa; outline:0; box-shadow:0 0 0 3px rgba(37,99,235,.10); }
input[type=checkbox], input[type=radio] { accent-color:var(--ktm-primary); }
.form-group input[type=checkbox], .form-group input[type=radio] { width:18px; min-height:18px; margin-right:.4rem; }
.lesson-item { margin:.75rem 0; padding:1rem; border:1px solid var(--ktm-border); border-left:3px solid #93c5fd; border-radius:.7rem; background:#fff; color:var(--ktm-text); }
.lesson-item h4 { margin:.1rem 0 .35rem; color:var(--ktm-text); }
.lesson-item p { margin:.25rem 0; color:var(--ktm-muted); }
.card-grid .plan-card { min-width:0; }
.contact-btn { display:inline-flex; align-items:center; justify-content:center; gap:.5rem; min-height:42px; padding:.65rem 1rem; border:1px solid #bfdbfe; border-radius:.6rem; color:#1d4ed8; background:#eff6ff; text-decoration:none; font-weight:650; }
.contact-btn:hover { background:#dbeafe; }
.loading { position:fixed; inset:0; z-index:3000; display:flex; align-items:center; justify-content:center; background:rgba(255,255,255,.82); }
.spinner { width:42px; height:42px; border:4px solid #e2e8f0; border-top-color:var(--ktm-primary); border-radius:50%; animation:ktm-spin .8s linear infinite; }
@keyframes ktm-spin { to { transform:rotate(360deg); } }
#alertContainer { position:fixed; z-index:3200; top:88px; right:1rem; width:min(420px,calc(100vw - 2rem)); }
.alert { margin-bottom:.75rem; padding:.9rem 1rem; border:1px solid var(--ktm-border); border-radius:.7rem; background:#fff; box-shadow:var(--ktm-shadow); }
.alert-success { color:#166534; border-color:#bbf7d0; background:#f0fdf4; }
.alert-error { color:#991b1b; border-color:#fecaca; background:#fef2f2; }
.alert.info, .alert-info { color:#1e40af; border-color:#bfdbfe; background:#eff6ff; }
.cookie-banner { position:fixed; z-index:2500; right:1rem; bottom:1rem; left:1rem; max-width:900px; margin-inline:auto; padding:1.1rem; border:1px solid var(--ktm-border); border-radius:1rem; color:var(--ktm-text); background:#fff; box-shadow:0 18px 50px rgba(15,23,42,.16); }
.cookie-banner-content { display:grid; gap:.8rem; }
.cookie-banner-actions { display:flex; flex-wrap:wrap; gap:.6rem; }
.cookie-banner p { margin:0; color:var(--ktm-muted); }
/* Keep legacy theme toggles from switching the product away from the white design. */
html[data-theme="dark"], html[data-theme="light"] { color-scheme:light; }
html[data-theme="dark"] body { color:var(--ktm-text); background:#fff; }
@media (max-width:640px) { #alertContainer { top:74px; right:.65rem; width:calc(100vw - 1.3rem); } .cookie-banner { right:.65rem; bottom:.65rem; left:.65rem; } }
@media (prefers-reduced-motion:reduce) { *,*::before,*::after { scroll-behavior:auto!important; animation-duration:.01ms!important; transition-duration:.01ms!important; } }

/* Shared component and page layouts */
:root {
  --color-bg: #fff;
  --color-bg-secondary: #f8fafc;
  --color-card: #fff;
  --color-text-primary: #17243a;
  --color-text-secondary: #64748b;
  --color-accent: #2563eb;
  --color-accent-light: #eff6ff;
  --color-border: #e2e8f0;
  --color-success: #16a34a;
  --color-warning: #d97706;
  --color-error: #dc2626;
  --font-stack: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
}

html {
  color-scheme: light;
  scroll-behavior: smooth;
}

body {
  padding-top: 72px;
  background: #fff;
  color: #17243a;
  font-family: var(--font-stack);
  overflow-x: hidden;
}

body.auth-drawer-open {
  overflow: hidden;
}

body::before,
body::after {
  display: none;
}

a {
  color: #2563eb;
}

.container {
  width: min(100% - 2rem, 1160px);
  padding: 0;
}

.navbar {
  height: 72px;
  background: rgba(255,255,255,.96);
  border-bottom: 1px solid #e2e8f0;
  box-shadow: 0 1px 3px rgba(15,23,42,.04);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.nav-container {
  max-width: 1200px;
  padding-inline: 1.25rem;
}

.nav-logo,
.logo,
.logo-link {
  display: inline-flex;
  align-items: center;
  gap: .65rem;
  color: #17243a;
  text-decoration: none;
  font-weight: 800;
}

.brand-name {
  color: #17243a;
  font-size: 1.1rem;
  letter-spacing: -.03em;
  white-space: nowrap;
}

.navbar .mdu-icon {
  color: #2563eb;
}

.nav-links {
  gap: .3rem;
}

.nav-links a {
  padding: .55rem .7rem;
  border-radius: .55rem;
  color: #475569;
  font-size: .9rem;
  text-decoration: none;
  transition: color .16s ease, background-color .16s ease;
}

.nav-links a:hover,
.nav-links a.active-link {
  color: #1d4ed8 !important;
  background: #eff6ff;
  border-color: transparent !important;
  box-shadow: none;
  transform: none;
}

.auth-btns {
  gap: .55rem;
}

.btn,
.hero-cta {
  min-height: 42px;
  padding: .65rem 1rem;
  border: 1px solid transparent;
  border-radius: .6rem;
  font: 650 .92rem/1.2 var(--font-stack);
  text-decoration: none;
  box-shadow: none;
  transition: background-color .16s ease, border-color .16s ease, color .16s ease, transform .16s ease;
}

.btn:hover,
.hero-cta:hover {
  transform: translateY(-1px);
  box-shadow: none;
}

.btn-primary,
.hero-cta {
  color: #fff;
  background: #2563eb;
  border-color: #2563eb;
}

.btn-primary:hover,
.hero-cta:hover {
  color: #fff;
  background: #1d4ed8;
  border-color: #1d4ed8;
}

.btn-secondary {
  color: #334155;
  background: #fff;
  border: 1px solid #cbd5e1;
}

.btn-secondary:hover {
  color: #1d4ed8;
  background: #f8fafc;
  border-color: #94a3b8;
}

.btn:focus-visible,
.hero-cta:focus-visible,
button:focus-visible,
a:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
  outline: 3px solid rgba(37,99,235,.28);
  outline-offset: 2px;
}

.hero {
  min-height: 0;
  padding: clamp(4rem, 8vw, 7rem) 0 !important;
  color: #17243a;
  text-align: left;
  background: #fff;
}

.hero::before,
.hero-particles {
  display: none;
}

.hero .container {
  max-width: 1160px;
}

.hero-content {
  max-width: 720px;
  margin: 0;
}

.hero-headline,
.hero h1 {
  margin: 0 0 1.25rem;
  color: #17243a;
  background: none;
  font-size: clamp(2.7rem, 6vw, 4.65rem);
  font-weight: 780;
  line-height: 1.06;
  letter-spacing: -.055em;
  text-shadow: none;
  -webkit-text-fill-color: currentColor;
}

.hero-subtext,
.hero p {
  max-width: 610px;
  margin: 0 0 1.8rem;
  padding: 0;
  border: 0;
  color: #64748b;
  font-size: clamp(1.05rem, 2vw, 1.2rem);
  line-height: 1.75;
  text-shadow: none;
  backdrop-filter: none;
}

.hero-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: .5rem;
  padding: .85rem 1.15rem;
  font-size: .98rem;
}

.cta-buttons {
  justify-content: flex-start;
  gap: .75rem;
}

.hero-visual {
  display: grid;
  align-items: center;
  justify-items: center;
  min-height: 310px;
  padding: 2rem;
  border: 1px solid #e2e8f0;
  border-radius: 1rem;
  background: linear-gradient(145deg, #f8fafc, #eff6ff);
}

.hero-visual-card {
  width: min(100%, 390px);
  padding: 1.5rem;
  border: 1px solid #e2e8f0;
  border-radius: .9rem;
  background: #fff;
  box-shadow: 0 16px 40px rgba(15,23,42,.08);
}

.hero-visual-card h2 {
  margin: .25rem 0 .35rem;
  font-size: 1.2rem;
}

.hero-visual-card p {
  margin: 0;
  color: #64748b;
  font-size: .9rem;
}

.visual-label,
.eyebrow {
  color: #2563eb;
  font-size: .75rem;
  font-weight: 750;
  letter-spacing: .09em;
  text-transform: uppercase;
}

.visual-progress {
  height: 8px;
  margin: 1.1rem 0 .5rem;
  overflow: hidden;
  border-radius: 99px;
  background: #e2e8f0;
}

.visual-progress span {
  display: block;
  width: 62%;
  height: 100%;
  border-radius: inherit;
  background: #2563eb;
}

.visual-progress-note {
  display: flex;
  justify-content: space-between;
  color: #64748b;
  font-size: .78rem;
}

.section {
  padding: clamp(3.5rem, 7vw, 5.75rem) 0;
}

.section--muted {
  background: #f8fafc;
}

.section-heading {
  max-width: 650px;
  margin: 0 auto 2.25rem;
  text-align: center;
}

.section-heading h2 {
  margin: .45rem 0 .65rem;
  color: #17243a;
  font-size: clamp(1.75rem, 4vw, 2.4rem);
  line-height: 1.2;
  letter-spacing: -.035em;
}

.section-heading p {
  margin: 0;
  color: #64748b;
}

.feature-grid,
.stats-grid,
.dashboard-grid,
.resource-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
}

.feature-card,
.stat-card,
.resource-card,
.section-card,
.plan-card,
.card {
  border: 1px solid #e2e8f0;
  border-radius: .85rem;
  background: #fff;
  box-shadow: 0 2px 6px rgba(15,23,42,.035);
  color: #17243a;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
}

.feature-card {
  padding: 1.35rem;
}

.feature-icon {
  display: grid;
  width: 42px;
  height: 42px;
  margin-bottom: 1rem;
  place-items: center;
  border-radius: .7rem;
  color: #2563eb;
  background: #eff6ff;
}

.feature-card h3,
.resource-card h3 {
  margin: 0 0 .4rem;
  font-size: 1.05rem;
}

.feature-card p,
.resource-card p {
  margin: 0;
  color: #64748b;
  font-size: .92rem;
}

.grade-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
}

.grade-card {
  padding: 1.35rem;
  border: 1px solid #e2e8f0;
  border-radius: .85rem;
  background: #fff;
  text-decoration: none;
  transition: border-color .16s ease, transform .16s ease;
}

.grade-card:hover {
  transform: translateY(-2px);
  border-color: #93c5fd;
}

.grade-card strong {
  display: block;
  color: #17243a;
  font-size: 1.15rem;
}

.grade-card span {
  color: #64748b;
  font-size: .88rem;
}

.public-plan-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1rem;
}

.public-plan-grid .plan-card {
  padding: 1.25rem;
}

.public-plan-grid .plan-card h3 {
  margin: 0 0 .7rem;
}

.public-plan-grid .plan-card strong {
  display: block;
  margin-bottom: .6rem;
  color: #1d4ed8;
  font-size: 1.4rem;
}

.public-plan-grid .plan-card p {
  margin: 0;
  color: #64748b;
  font-size: .88rem;
}

.steps {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.5rem;
  counter-reset: step;
}

.step-card {
  position: relative;
  padding: 1rem 1rem 1rem 3.7rem;
}

.step-card::before {
  counter-increment: step;
  content: counter(step);
  position: absolute;
  top: .8rem;
  left: .65rem;
  display: grid;
  width: 2.35rem;
  height: 2.35rem;
  place-items: center;
  border-radius: 50%;
  color: #1d4ed8;
  background: #eff6ff;
  font-weight: 750;
}

.step-card h3 {
  margin: .3rem 0;
  font-size: 1rem;
}

.step-card p {
  margin: 0;
  color: #64748b;
  font-size: .9rem;
}

.faq-list {
  max-width: 780px;
  margin: 0 auto;
}

.faq-list details {
  padding: 1rem 0;
  border-bottom: 1px solid #e2e8f0;
}

.faq-list summary {
  color: #17243a;
  font-weight: 650;
  cursor: pointer;
}

.faq-list p {
  margin-bottom: 0;
  color: #64748b;
}

.section-cta {
  padding: 1.5rem;
  border: 1px solid #bfdbfe;
  border-radius: .9rem;
  background: #eff6ff;
}

.section-cta h2 {
  margin: 0 0 .4rem;
}

.section-cta p {
  color: #475569;
}

.footer {
  padding: 3rem 0;
  border-top: 1px solid #e2e8f0;
  color: #64748b;
  background: #fff;
  text-align: left;
  box-shadow: none;
}

.footer::before {
  display: none;
}

.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr;
  gap: 2rem;
}

.footer h3,
.footer h4 {
  color: #17243a;
}

.footer a {
  color: #475569;
}

.footer a:hover {
  color: #2563eb;
}

.footer-links {
  display: grid;
  gap: .5rem;
}

.auth-drawer-overlay {
  position: fixed;
  inset: 0;
  z-index: 2100;
  background: rgba(15,23,42,.48);
  opacity: 0;
  visibility: hidden;
  transition: opacity .22s ease, visibility .22s ease;
}

.auth-drawer-overlay.is-open {
  opacity: 1;
  visibility: visible;
}

.auth-drawer {
  position: fixed;
  inset: 0 0 0 auto;
  z-index: 2101;
  display: flex;
  width: min(100%, 470px);
  flex-direction: column;
  overflow-y: auto;
  background: #fff;
  box-shadow: -16px 0 48px rgba(15,23,42,.16);
  transform: translateX(102%);
  transition: transform .24s ease;
}

.auth-drawer.is-open {
  transform: translateX(0);
}

.auth-drawer-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 1.5rem;
  border-bottom: 1px solid #e2e8f0;
}

.auth-drawer-header h2 {
  margin: .3rem 0 0;
  font-size: 1.5rem;
}

.auth-drawer-close {
  display: grid;
  width: 40px;
  height: 40px;
  place-items: center;
  border: 1px solid #e2e8f0;
  border-radius: .6rem;
  color: #475569;
  background: #fff;
  cursor: pointer;
}

.auth-tabs {
  display: flex;
  gap: .5rem;
  padding: 1rem 1.5rem 0;
}

.auth-tab {
  flex: 1;
  padding: .75rem;
  border: 1px solid #e2e8f0;
  border-radius: .55rem;
  color: #64748b;
  background: #fff;
  font-weight: 650;
  cursor: pointer;
}

.auth-tab.is-active {
  color: #1d4ed8;
  border-color: #bfdbfe;
  background: #eff6ff;
}

.auth-form-wrap {
  padding: 1.5rem;
}

.auth-form-wrap[hidden] {
  display: none !important;
}

.auth-form-wrap h3 {
  margin: 0 0 .35rem;
  font-size: 1.2rem;
}

.auth-form-wrap > p {
  margin: 0 0 1.25rem;
  color: #64748b;
  font-size: .92rem;
}

.auth-form-wrap form {
  text-align: left;
}

.auth-form-wrap .form-group {
  margin-bottom: 1rem;
}

.auth-form-wrap label {
  display: block;
  margin-bottom: .4rem;
  color: #334155;
  font-size: .9rem;
  font-weight: 600;
}

.auth-form-wrap input,
.auth-form-wrap select,
.form-group input,
.form-group select,
.form-group textarea {
  width: 100%;
  min-height: 44px;
  padding: .65rem .75rem;
  border: 1px solid #cbd5e1;
  border-radius: .55rem;
  color: #17243a;
  background: #fff;
  font: 400 .95rem/1.4 var(--font-stack);
}

.auth-form-wrap input[type="checkbox"],
.form-group input[type="checkbox"] {
  width: 18px;
  min-height: 18px;
  accent-color: #2563eb;
}

.auth-form-wrap .checkbox-line {
  display: flex;
  align-items: center;
  gap: .55rem;
}

.auth-form-wrap .checkbox-line label {
  margin: 0;
  font-weight: 500;
}

.auth-inline-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: .75rem;
  margin: .2rem 0 1rem;
  font-size: .87rem;
}

.auth-inline-row a,
.auth-form-wrap a {
  color: #2563eb;
  font-weight: 600;
}

.password-field {
  position: relative;
}

.password-field input {
  padding-right: 5rem;
}

.password-toggle {
  position: absolute;
  top: 50%;
  right: .6rem;
  padding: .35rem;
  border: 0;
  color: #475569;
  background: transparent;
  font-size: .8rem;
  cursor: pointer;
  transform: translateY(-50%);
}

.form-submit {
  width: 100%;
}

.text-button {
  padding: 0;
  border: 0;
  color: #2563eb;
  background: transparent;
  font: inherit;
  font-weight: 650;
  cursor: pointer;
}

.form-help {
  margin-top: 1rem;
  color: #64748b;
  text-align: center;
  font-size: .9rem;
}

.mobile-nav-toggle {
  display: none;
}

.dashboard-shell {
  display: grid;
  grid-template-columns: 230px minmax(0,1fr);
  gap: 2rem;
  width: min(100% - 2rem, 1240px);
  margin: 2rem auto 4rem;
}

.dashboard-sidebar {
  align-self: start;
  position: sticky;
  top: 92px;
  padding: 1rem;
  border: 1px solid #e2e8f0;
  border-radius: .85rem;
  background: #fff;
}

.dashboard-sidebar h2 {
  margin: .25rem .65rem 1rem;
  font-size: .9rem;
}

.dashboard-sidebar nav {
  display: grid;
  gap: .25rem;
}

.dashboard-sidebar a {
  display: flex;
  gap: .65rem;
  align-items: center;
  padding: .7rem .65rem;
  border-radius: .55rem;
  color: #475569;
  font-size: .88rem;
  text-decoration: none;
}

.dashboard-sidebar a:hover,
.dashboard-sidebar a.is-active {
  color: #1d4ed8;
  background: #eff6ff;
}

.dashboard-main {
  min-width: 0;
}

.dashboard-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.dashboard-title-row h1 {
  margin: .2rem 0;
  font-size: clamp(1.7rem, 4vw, 2.2rem);
  letter-spacing: -.04em;
}

.dashboard-title-row p,
.muted {
  color: #64748b;
}

.stats-grid {
  grid-template-columns: repeat(3, minmax(0,1fr));
  margin-bottom: 1.25rem;
}

.stat-card {
  padding: 1.2rem;
}

.stat-card span {
  display: block;
  color: #64748b;
  font-size: .83rem;
}

.stat-card strong {
  display: block;
  margin-top: .35rem;
  font-size: 1.65rem;
}

.progress-track {
  height: 8px;
  overflow: hidden;
  border-radius: 99px;
  background: #e2e8f0;
}

.progress-track span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: #2563eb;
}

.section-card {
  padding: 1.25rem;
  margin-bottom: 1.25rem;
}

.section-card h2 {
  margin: 0 0 1rem;
  font-size: 1.15rem;
}

.section-card .lesson-item {
  padding: 1rem 0;
  border-bottom: 1px solid #e2e8f0;
  color: #17243a;
}

.section-card .lesson-item:last-child {
  border-bottom: 0;
}

.section-card .lesson-item p {
  color: #64748b;
}

.section-card .lesson-item h4 {
  margin-bottom: .35rem;
  color: #17243a;
}

.download-btn {
  display: inline-flex;
  margin-top: .45rem;
  color: #2563eb;
  font-weight: 650;
  text-decoration: none;
}

.demo-note {
  display: inline-flex;
  align-items: center;
  gap: .35rem;
  padding: .3rem .55rem;
  border-radius: 99px;
  color: #475569;
  background: #f1f5f9;
  font-size: .75rem;
  font-weight: 650;
}

.admin-layout {
  display: grid;
  grid-template-columns: 220px minmax(0,1fr);
  gap: 1.5rem;
  width: min(100% - 2rem, 1240px);
  margin: 2rem auto 4rem;
}

.admin-navigation {
  align-self: start;
  position: sticky;
  top: 92px;
  padding: 1rem;
  border: 1px solid #e2e8f0;
  border-radius: .85rem;
  background: #fff;
}

.admin-navigation h2 {
  margin: .25rem .6rem 1rem;
  font-size: .9rem;
}

.admin-navigation a {
  display: block;
  padding: .7rem .6rem;
  border-radius: .55rem;
  color: #475569;
  font-size: .87rem;
  text-decoration: none;
}

.admin-navigation a:hover {
  color: #1d4ed8;
  background: #eff6ff;
}

.admin-content {
  min-width: 0;
}

.admin-content .card {
  padding: 1.5rem;
  margin-bottom: 1rem;
}

.admin-content h1,
.admin-content h2 {
  color: #17243a;
}

.admin-content .form-group label {
  display: block;
  margin-bottom: .4rem;
  color: #334155;
  font-weight: 600;
}

.mobile-sidebar-toggle {
  display: none;
}

.workspace-drawer-overlay {
  display: none;
}

.workspace-drawer-open {
  overflow: hidden;
}

.contact-grid {
  color: #17243a;
}

.contact-lead,
.contact-grid p {
  color: #64748b;
}

.plan-card {
  padding: 1.5rem;
  box-shadow: 0 2px 6px rgba(15,23,42,.035);
}

.plan-card:hover,
.plan-card.popular {
  border-color: #93c5fd;
  transform: translateY(-2px);
}

.card:hover {
  transform: translateY(-2px);
  border-color: #cbd5e1;
  box-shadow: 0 6px 16px rgba(15,23,42,.06);
}

.plan-card h3 {
  color: #17243a;
}

#planBadge {
  border: 1px solid #bfdbfe;
  color: #1d4ed8 !important;
  background: #eff6ff !important;
}

.hero .card {
  width: min(100%, 620px);
  margin-inline: auto;
  padding: clamp(1.25rem, 4vw, 2.5rem);
}

.hero .card .hero-headline {
  color: #17243a !important;
}

.hero .card p {
  color: #64748b !important;
}

.hero .card form {
  text-align: left;
}

.hero .card form > .btn {
  display: block;
  margin-inline: auto;
}

.mdu-page-top > .card,
.mdu-page-top > .card h1,
.mdu-page-top > .card p {
  color: #17243a !important;
}

.mdu-page-top > .card p {
  color: #64748b !important;
}

.admin-content .empty-state {
  padding: 1.25rem;
  border: 1px dashed #cbd5e1;
  border-radius: .65rem;
  color: #64748b;
  background: #f8fafc;
}

.data-table {
  width: 100%;
  min-width: 520px;
  border-collapse: collapse;
  text-align: left;
}

.data-table th,
.data-table td {
  padding: .8rem;
  border-bottom: 1px solid #e2e8f0;
  color: #475569;
  font-size: .88rem;
}

.data-table th {
  color: #17243a;
  background: #f8fafc;
  font-weight: 700;
}

.cookie-banner {
  z-index: 2000;
}

@media (max-width: 900px) {
  .nav-wrapper > .nav-links {
    display: none;
  }

  .mobile-nav-toggle {
    display: inline-flex;
    width: 42px;
    height: 42px;
    align-items: center;
    justify-content: center;
    border: 1px solid #e2e8f0;
    border-radius: .6rem;
    color: #17243a;
    background: #fff;
    font-size: 1.1rem;
  }

  .nav-wrapper {
    justify-content: flex-end;
  }

  .mobile-menu {
    position: fixed;
    z-index: 1600;
    top: 72px;
    right: 0;
    left: 0;
    padding: .75rem 1rem 1rem;
    border-bottom: 1px solid #e2e8f0;
    background: #fff;
    box-shadow: 0 12px 20px rgba(15,23,42,.08);
  }

  .mobile-menu.active {
    display: block;
  }

  .mobile-menu .nav-links {
    display: grid;
    gap: .2rem;
  }

  .mobile-menu .nav-links a {
    justify-content: flex-start;
    color: #334155;
  }

  .menu-overlay.active {
    position: fixed;
    z-index: 1550;
    inset: 72px 0 0;
    display: block;
    background: rgba(15,23,42,.22);
  }
}

@media (max-width: 760px) {
  .hero-layout {
    grid-template-columns: 1fr !important;
  }

  .hero-visual {
    min-height: 250px;
  }

  .feature-grid,
  .resource-grid,
  .steps,
  .stats-grid,
  .dashboard-grid,
  .public-plan-grid {
    grid-template-columns: repeat(2, minmax(0,1fr));
  }

  .dashboard-shell,
  .admin-layout {
    grid-template-columns: 1fr;
  }

  .dashboard-sidebar,
  .admin-navigation {
    position: fixed;
    z-index: 1800;
    top: 0;
    bottom: 0;
    left: 0;
    width: min(86vw, 320px);
    overflow-y: auto;
    border-radius: 0;
    background: #fff;
    box-shadow: 12px 0 32px rgba(15,23,42,.14);
    transform: translateX(-105%);
    transition: transform .22s ease;
  }

  .dashboard-sidebar.is-open,
  .admin-navigation.is-open {
    transform: translateX(0);
  }

  .mobile-sidebar-toggle {
    display: inline-flex;
  }

  .workspace-drawer-overlay:not([hidden]) {
    position: fixed;
    z-index: 1790;
    inset: 0;
    display: block;
    border: 0;
    background: rgba(15,23,42,.42);
  }
}

@media (max-width: 540px) {
  body {
    padding-top: 64px;
  }

  .navbar {
    height: 64px;
  }

  .nav-container {
    gap: .4rem;
    padding-inline: .75rem;
  }

  .brand-name {
    font-size: .98rem;
  }

  .logo-img {
    height: 28px;
  }

  .auth-btns {
    gap: .35rem;
  }

  .auth-btns .btn {
    min-height: 38px;
    padding: .5rem .65rem;
    font-size: .82rem;
  }

  .mobile-menu {
    top: 64px;
  }

  .menu-overlay.active {
    inset-block-start: 64px;
  }

  .hero {
    padding: 3.5rem 0;
  }

  .hero-headline,
  .hero h1 {
    font-size: clamp(2.35rem, 12vw, 3.3rem);
  }

  .hero-visual {
    min-height: 220px;
    padding: 1rem;
  }

  .feature-grid,
  .resource-grid,
  .steps,
  .stats-grid,
  .dashboard-grid,
  .public-plan-grid,
  .grade-grid {
    grid-template-columns: 1fr;
  }

  .section {
    padding: 3.25rem 0;
  }

  .footer-grid {
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .dashboard-shell,
  .admin-layout {
    width: min(100% - 1.25rem, 1240px);
    margin-block: 1rem 3rem;
  }

  .dashboard-title-row {
    display: block;
  }

  .dashboard-sidebar nav,
  .admin-navigation nav {
    grid-template-columns: 1fr 1fr;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
  }
}

/* Final KTM release refinements */
.public-plan-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); width: min(100%, 1000px); margin-inline: auto; align-items: stretch; }
.public-plan-grid .plan-card { display:flex; flex-direction:column; align-items:flex-start; gap:.55rem; }
.public-plan-grid .plan-card ul { margin:.25rem 0 1rem; padding-left:1.15rem; color:#475569; }
.public-plan-grid .plan-card li { margin:.35rem 0; }
.public-plan-grid .plan-card .btn { width:100%; margin-top:auto; }
.public-plan-grid .plan-card strong { color:#1d4ed8; }
.public-plan-grid .plan-card strong small { color:#64748b; font-size:.85rem; font-weight:500; }
.announcement-important { border-left-color:#f59e0b; background:#fffbeb; }
@media (max-width:760px) { .public-plan-grid { grid-template-columns:1fr; } }

/* Global page rhythm and shared brand sizing */
.mdu-page-top { padding-top: 2.5rem; }
.logo-img { display:block; width:38px; height:38px; object-fit:contain; }
.logo-link { text-decoration:none; }
.container { margin-inline:auto; }
.card-grid { align-items:stretch; }
.card-grid > * { min-width:0; }
@media (max-width:540px) { .mdu-page-top { padding-top:1.25rem; } }

/* Lightweight local icon fallback (the bundled Font Awesome file is a placeholder). */
.fa-solid, .fa-regular { display:inline-block; width:1.15em; font-style:normal; font-weight:700; line-height:1; text-align:center; }
.fa-house::before { content:"⌂"; }
.fa-book-open::before, .fa-book::before, .fa-file-lines::before { content:"▤"; }
.fa-bookmark::before { content:"◆"; }
.fa-bell::before { content:"♢"; }
.fa-calendar::before, .fa-calendar-days::before { content:"▦"; }
.fa-chart-line::before { content:"↗"; }
.fa-clipboard-check::before { content:"✓"; }
.fa-comments::before { content:"…"; }
.fa-compass::before { content:"⊙"; }
.fa-envelope::before { content:"✉"; }
.fa-file-arrow-down::before { content:"↓"; }
.fa-folder-open::before { content:"▱"; }
.fa-headset::before, .fa-phone::before { content:"☎"; }
.fa-layer-group::before { content:"▥"; }
.fa-magnifying-glass::before { content:"⌕"; }
.fa-pen-to-square::before { content:"✎"; }
.fa-user::before { content:"●"; }
.fa-arrow-right::before { content:"→"; }
.fa-bars::before { content:"☰"; }
.fa-xmark::before { content:"×"; }
.fa-circle-play::before { content:"▶"; }
.fa-moon::before { content:"◐"; }
.fa-sun::before { content:"☼"; }
